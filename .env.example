# Copy to .env and fill in. Blank optional values mean "not set".

# Discord application (Developer Portal → your app)
DISCORD_TOKEN=
DISCORD_APP_ID=
# Your Discord user ID; always counts as an admin
OWNER_ID=

# MySQL: the existing Professor Pine database, or an empty schema for a new install.
# In the Docker stack DB_HOST and DB_PORT are ignored (the bot reaches the stack's MySQL as
# mysql:3306), and DB_USER, DB_PASSWORD and DB_SCHEMA also create that user and database on the
# stack's first start (DB_USER must not be root).
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_SCHEMA=pine

# Optional
# The legacy bot's address of Pokémon icons: read by nothing any more, leave it blank (a legacy
# installation's value may stay).
POKEMON_IMAGE_BASE=
GOOGLE_API_KEY=
# The web pages (settings.web), both optional. The OAuth2 client secret of the Discord
# application (Developer Portal, OAuth2) for "Log in with Discord"; without it members log in
# with the link /maps gives them. A Google Maps key for browsers, restricted to the Map Tiles
# API and by HTTP referrer to the public address (<publicUrl>/*), for Google's tiles
# (settings.web.tiles: google); never the same key as GOOGLE_API_KEY. See docs/web-setup.md.
DISCORD_CLIENT_SECRET=
GOOGLE_MAPS_BROWSER_KEY=
# /request opens an issue in GITHUB_REPO (owner/repo) for each gym request; without both it is
# not offered. The token needs Issues: write on that repository, and push access (a fine-grained
# token's Contents: write, or a collaborator's classic token) for the gym's number to be set as
# the issue's label: without it GitHub opens the issue and drops the label silently.
GITHUB_TOKEN=
GITHUB_REPO=

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# development enables pretty logs
NODE_ENV=production
# SETTINGS_PATH=data/settings.json

# ---- Docker stack (compose.yaml, ./pine) ----
# Compose reads this file for the values of compose.yaml and hands it whole to the bot. Quote a
# value that holds a $ with single quotes ('pa$$word'), or Compose reads the $ as a variable.
# Ignored there: DB_HOST, DB_PORT, NODE_ENV and SETTINGS_PATH (the stack sets them).
# The settings are pine-settings.json beside compose.yaml (copy data/settings.json; git-ignored).
# The password of MySQL's root user in the stack, set on its first start; the bot never sees it.
DB_ROOT_PASSWORD=
# The stack's name (its containers, volumes and image): `pine` when unset. A second stack on the
# same machine (a rehearsal) names itself here, in its own env file (PINE_ENV_FILE).
# COMPOSE_PROJECT_NAME=pine
# The web pages through a Cloudflare Tunnel (docs/web-setup.md): COMPOSE_PROFILES=tunnel starts
# the stack's cloudflared with the tunnel's token. pine-settings.json then needs a `web` block
# such as {"host": "0.0.0.0", "port": 8080, "publicUrl": "https://map.profpine.com",
# "trustProxy": true}: the bot listens inside the stack's network only (no port is published),
# and the tunnel's public hostname points at http://pine:8080.
# COMPOSE_PROFILES=tunnel
CLOUDFLARE_TUNNEL_TOKEN=
# Backups: a verified dump every day at BACKUP_TIME (24-hour HH:MM) in BACKUP_TZ (blank: the
# settings' timezone) into BACKUP_DIR on the host (a path relative to compose.yaml, or absolute:
# for an NFS share, the host's mount point), kept BACKUP_KEEP_DAYS days. The folder must hold a
# file .pine-backups, made once by hand (touch <BACKUP_DIR>/.pine-backups): without it (a share
# that is not mounted) no backup is written. Files there are written as BACKUP_UID:BACKUP_GID,
# for that owner alone (0:0, root, by default; on Linux your own ids, `id -u` and `id -g`, so that
# you can read them; the share's owner for NFS with root_squash). A blank BACKUP_DIR switches
# backups off (a development or rehearsal stack): none is made and the watchdog watches none.
BACKUP_DIR=./backups
BACKUP_TIME=03:30
BACKUP_TZ=
BACKUP_KEEP_DAYS=90
BACKUP_UID=0
BACKUP_GID=0
# The legacy bot's parties folder (the one holding active/), copied from the legacy
# installation: /admin cleanup-legacy reads it, read-only, for the channels of the legacy parties
# that had not ended. A path relative to compose.yaml, or absolute; blank when there is none (the
# cleanup then finds the legacy channels by their names and first messages alone).
LEGACY_PARTIES_DIR=
# The folder of the Pine Wayspot export tool (its pine-wayspot-export.user.js and CHANGELOG.md),
# on the owner's instance only: with the web pages and DISCORD_CLIENT_SECRET, /userscript then
# lets the admins of other instances ask for it. A path relative to compose.yaml, or absolute;
# blank is ./wayspot-tool, which ./pine makes when it is missing. An empty folder serves nothing.
PINE_TOOL_DIR=
# The watchdog restarts the bot after it has been stuck (a stale heartbeat) this many minutes,
# and DMs OWNER_ID when the bot has been unhealthy for another reason (the database, Discord, a
# long start) WATCHDOG_ALERT_MINUTES, restarted WATCHDOG_RESTARTS times within
# WATCHDOG_RESTART_WINDOW_MINUTES, or no backup succeeded for WATCHDOG_BACKUP_HOURS. Blank means
# the default shown. WATCHDOG_INTERVAL_SECONDS is how often it looks.
WATCHDOG_INTERVAL_SECONDS=30
WATCHDOG_UNHEALTHY_MINUTES=5
WATCHDOG_ALERT_MINUTES=15
# Discord away this long and the watchdog restarts the bot after all (a wedged client).
WATCHDOG_GATEWAY_RESTART_MINUTES=5
WATCHDOG_RESTARTS=3
WATCHDOG_RESTART_WINDOW_MINUTES=30
WATCHDOG_BACKUP_HOURS=26
