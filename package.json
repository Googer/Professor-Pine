{
  "name": "professor-pine",
  "version": "2.0.0",
  "description": "Professor Pine Discord bot for Pokemon Go",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @pine/wayspot-core && tsc -p tsconfig.build.json && npm run web:build",
    "start": "node --env-file-if-exists=.env --enable-source-maps dist/index.js",
    "dev": "tsx watch --conditions=pine-source --env-file-if-exists=.env src/index.ts",
    "migrate": "tsx --conditions=pine-source --env-file-if-exists=.env src/db/migrate-cli.ts",
    "history:import": "tsx --conditions=pine-source --env-file-if-exists=.env src/ops/history-import-cli.ts",
    "activity:rebuild": "tsx --conditions=pine-source --env-file-if-exists=.env src/ops/activity-rebuild-cli.ts",
    "gyms:seed": "tsx --conditions=pine-source --env-file-if-exists=.env src/ops/gym-seed-cli.ts",
    "stops:seed": "tsx --conditions=pine-source --env-file-if-exists=.env src/ops/stop-seed-cli.ts",
    "deploy-commands": "tsx --conditions=pine-source --env-file-if-exists=.env src/discord/deploy-cli.ts",
    "fixtures:game-data": "tsx --conditions=pine-source scripts/game-data/make-fixtures.ts",
    "eggs:make": "tsx --conditions=pine-source scripts/eggs/make-eggs.ts",
    "raid-bosses:check": "tsx --conditions=pine-source scripts/raid-bosses/check-feed.ts",
    "pvpivs:check": "tsx --conditions=pine-source scripts/pvpivs/check-names.ts",
    "ocr:check": "tsx --conditions=pine-source scripts/ocr/check.ts",
    "ocr:review": "tsx --conditions=pine-source scripts/ocr/review.ts",
    "role-auth:export": "tsx --conditions=pine-source --env-file-if-exists=.env src/ops/role-auth-cli.ts",
    "emoji:upload": "tsx --conditions=pine-source --env-file-if-exists=.env src/ops/emoji-upload-cli.ts",
    "settings:convert": "tsx --conditions=pine-source src/ops/convert-settings-cli.ts",
    "cutover:check": "tsx --conditions=pine-source --env-file-if-exists=.env src/ops/cutover-check-cli.ts",
    "db:codegen": "tsx --conditions=pine-source scripts/codegen.ts",
    "gantt": "tsx --conditions=pine-source scripts/gantt/update.ts",
    "web:build": "tsx --conditions=pine-source scripts/web/build.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/web/client",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx scripts/suite-lock/run.ts test:all",
    "test:all": "vitest run",
    "test:unit": "tsx scripts/suite-lock/run.ts test:unit:run",
    "test:unit:run": "vitest run --project unit --project isolated --project shell",
    "test:db": "tsx scripts/suite-lock/run.ts test:db:run",
    "test:db:run": "vitest run --project db",
    "check": "tsx scripts/suite-lock/run.ts check:run",
    "check:run": "npm run lint && npm run format:check && npm run typecheck && npm run test:unit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Googer/Professor-Pine.git"
  },
  "author": "Matt Legowski, Chris Vaccarello",
  "license": "GPL-3.0",
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.10",
    "@geoman-io/leaflet-geoman-free": "^2.20.6",
    "discord.js": "^14.28.1",
    "fastest-levenshtein": "^1.0.16",
    "fastify": "^5.12.8",
    "he": "^2.0.0",
    "kysely": "^0.29.8",
    "leaflet": "^1.9.4",
    "minisearch": "^7.2.0",
    "mysql2": "^3.24.6",
    "onnxruntime-node": "1.31.1",
    "pino": "^10.4.0",
    "polyclip-ts": "^0.16.8",
    "sharp": "0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/mysql": "^12.2.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "kysely-codegen": "^0.20.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.3"
  }
}
