{
  "compilerOptions": {
    "target": "ES2025",
    "lib": ["ES2025", "ESNext.Collection", "ESNext.Temporal"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "rootDir": ".",
    "noEmit": true,
    // `@pine/wayspot-core` (packages/wayspot-core) is read from its TypeScript sources by the
    // typecheck, tsx, Vitest and esbuild; the compiled bot (tsconfig.build.json) and Node read
    // its built files.
    "customConditions": ["pine-source"]
  },
  "include": ["src", "test", "scripts", "packages", "vitest.config.ts"],
  "exclude": ["src/web/client", "packages/*/dist"]
}
